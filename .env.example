# --- Frontend (Vite) ---
# Public Convex deployment URL. Created by `npx convex dev` on first run.
VITE_CONVEX_URL=

# --- Convex backend (set in the Convex dashboard, not in this file) ---
# These are listed here for documentation; do not commit real values.
#
# Convex CLI local-development bookkeeping. Created by `npx convex dev`.
CONVEX_DEPLOYMENT=

# The single email permitted to create / sign in as admin. Sign-up for any
# other email is rejected server-side.
ADMIN_EMAIL=you@example.com

# Public site origin used in outgoing ntfy notification "Open admin portal"
# action. Omit the trailing slash. Example: https://rushes.example.com
SITE_URL=

# Optional. Topic name for ntfy.sh push notifications. WARNING: ntfy.sh is a
# public broadcast service — anyone who learns this topic name will see all
# feedback notifications (client name, project title, feedback summary).
# Use 24+ random bytes (e.g. `openssl rand -base64 32`) and treat as a secret.
# Leave blank to disable notifications.
NTFY_TOPIC=
